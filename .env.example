# DigitalOcean / production checklist:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=*   # or comma-separated proxy IPs if not behind a stripping LB
#
# Then run: php artisan config:clear

APP_NAME="Bantay Kalusugan"
APP_ENV=local
