APP_NAME=Laravel
# DigitalOcean production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.com
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: http://127.0.0.1:8000 — After copy: php artisan key:generate
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: warning or error
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=BantayKLSG
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production (DigitalOcean): SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null

# API bearer tokens (Sanctum). Access is short-lived; refresh quietly renews it.
API_ACCESS_TOKEN_TTL=15
API_REFRESH_TOKEN_TTL=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Optional: seconds before SMTP gives up. If Gmail hangs, try MAIL_EHLO_DOMAIN=127.0.0.1 or your host name.
MAIL_TIMEOUT=30
# MAIL_EHLO_DOMAIN=
# If SMTP fails with "certificate verify failed" and openssl.cafile is empty in php.ini, set false for local dev only.
# Prefer fixing PHP: download https://curl.se/ca/cacert.pem and set openssl.cafile in php.ini.
MAIL_VERIFY_PEER=true

# Server-side only — never expose in frontend JS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
