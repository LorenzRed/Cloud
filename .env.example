APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:mWQHtRlMAj/h3cx8InMDcgV3wwDrk1EnmfiNTTbkLIs=
APP_DEBUG=true
# Use the exact URL you open in the browser (include port for "php artisan serve", e.g. http://127.0.0.1:8000). Reset links fall back to this when not generated during a web request.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=BantayKLSG
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Optional: seconds before SMTP gives up. If Gmail hangs, try MAIL_EHLO_DOMAIN=127.0.0.1 or your host name.
MAIL_TIMEOUT=30
# MAIL_EHLO_DOMAIN=
# If SMTP fails with "certificate verify failed" and openssl.cafile is empty in php.ini, set false for local dev only.
# Prefer fixing PHP: download https://curl.se/ca/cacert.pem and set openssl.cafile in php.ini.
MAIL_VERIFY_PEER=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
